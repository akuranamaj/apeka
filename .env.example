# === Branding ===
SITE_TITLE=Web2APK Panel
SITE_NAME=Web2APK
OWNER_NAME=Nama Owner Kamu
CONTACT_OWNER=@username_telegram_kamu

# === Telegram bot ===
BOT_TOKEN=123456:isi-token-bot-telegram-kamu
ADMIN_ID=8492769135
BOT_WEBHOOK_SECRET=isi-string-acak-panjang
# Foto banner yang muncul di menu utama bot (link gambar langsung, format jpg/png)
BOT_MENU_PHOTO_URL=https://contoh.com/banner-bot.jpg

# === Channel verifikasi Telegram ===
CHANNEL_USERNAME=nama_channel_tanpa_at
CHANNEL_URL=https://t.me/nama_channel

# === GitHub (repo tempat build.yml kamu jalan) ===
GITHUB_TOKEN=ghp_isi-personal-access-token-kamu
GITHUB_OWNER=akuranamaj
GITHUB_REPO=web2apk-builder
GITHUB_WORKFLOW_FILE=build.yml
GITHUB_REF=main

# Secret yang harus sama persis dengan yang dipakai step terakhir di build.yml
# saat workflow lapor balik ke panel ini (lihat workflow-example/build.yml)
BUILD_CALLBACK_SECRET=isi-string-acak-panjang-lain

# === Database (disimpan sebagai file JSON di repo GitHub, lewat GitHub API) ===
# Boleh pakai repo yang sama dengan GITHUB_REPO di atas, boleh juga repo lain
# khusus penyimpanan (disarankan repo PRIVATE terpisah). Kalau dikosongkan,
# otomatis ikut GITHUB_OWNER/GITHUB_REPO di atas.
GITHUB_DB_OWNER=
GITHUB_DB_REPO=
GITHUB_DB_PATH=data/db.json
GITHUB_DB_BRANCH=main

# === Auth ===
JWT_SECRET=isi-string-acak-panjang-lagi

# === Lain-lain ===
PUBLIC_URL=https://nama-project-kamu.vercel.app
